<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PackageId>RetainerSorter</PackageId>
		<AssemblyName>RetainerSorter</AssemblyName>
		<RootNamespace>RetainerSorter</RootNamespace>
		<Version>0.1.0.0</Version>
		<RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="RetainerSorter.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="images\icon.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<!-- License notice that has to travel with the released zip. -->
		<Content Include="..\KamiToolKit\LICENSE" Link="LICENSE.KamiToolKit.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
